### List products within an inclusive stock range (200)
GET {{host}}/api/products/stock-level?min=13&max=13
Accept: application/json

> {%
    client.test("200 including the product with stock 13", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.every(function (p) { return p.stock === 13; }), "Expected only stock 13");
        var id = client.global.get("productId");
        client.assert(response.body.some(function (p) { return String(p.id) === String(id); }), "Expected product " + id + " in the results");
    });
%}

