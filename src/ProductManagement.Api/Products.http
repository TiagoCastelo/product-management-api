@host = http://localhost:5080

### List all products (200, every product includes its stock)
GET {{host}}/api/products
Accept: application/json

> {%
    client.test("200 with products that include stock", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.length > 0, "Expected a non-empty list");
        client.assert(response.body[0].stock !== undefined, "Expected stock on every product");
    });
%}

### Create a product (201, six-digit id, Location header)
POST {{host}}/api/products
Content-Type: application/json
Accept: application/json

{
  "sku": "KB-{{$timestamp}}",
  "name": "Mechanical Keyboard",
  "description": "Tactile mechanical keyboard",
  "price": 49.99,
  "stock": 12
}

> {%
    client.test("201 with a six-digit id", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.id >= 100000 && response.body.id <= 999999, "Expected a six-digit id");
        client.assert(response.headers.valueOf("Location") === "/api/products/" + response.body.id, "Expected a Location header");
    });
    client.global.set("productId", response.body.id);
    client.global.set("productSku", response.body.sku);
    client.global.set("originalRowVersion", response.body.rowVersion);
%}

### Create a product with an invalid body: bad sku, empty name, price and stock out of range (400)
POST {{host}}/api/products
Content-Type: application/json
Accept: application/json

{
  "sku": "bad sku!",
  "name": "",
  "price": 0,
  "stock": -1
}

> {%
    client.test("400 with an error per invalid field", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        ["sku", "name", "price", "stock"].forEach(function (field) {
            client.assert(response.body.errors[field] !== undefined, "Expected an error for " + field);
        });
    });
%}

### Create a product with a SKU that already exists (409)
POST {{host}}/api/products
Content-Type: application/json
Accept: application/json

{
  "sku": "{{productSku}}",
  "name": "Mechanical Keyboard Duplicate",
  "price": 59.99,
  "stock": 5
}

> {%
    client.test("409 Duplicate SKU", function () {
        client.assert(response.status === 409, "Expected 409 but got " + response.status);
        client.assert(response.body.title === "Duplicate SKU", "Unexpected title: " + response.body.title);
    });
%}

### Create a product close to the stock overflow boundary, used below
POST {{host}}/api/products
Content-Type: application/json
Accept: application/json

{
  "sku": "OVF-{{$timestamp}}",
  "name": "Overflow Candidate",
  "price": 9.99,
  "stock": 2147483645
}

> {%
    client.test("201", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    client.global.set("overflowProductId", response.body.id);
%}

### Create a product dedicated to the delete happy path, used below
POST {{host}}/api/products
Content-Type: application/json
Accept: application/json

{
  "sku": "DEL-{{$timestamp}}",
  "name": "Delete Candidate",
  "price": 5.00,
  "stock": 1
}

> {%
    client.test("201", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    client.global.set("deleteProductId", response.body.id);
%}

### Get a product by id (200)
GET {{host}}/api/products/{{productId}}
Accept: application/json

> {%
    client.test("200 with the created product", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.sku === client.global.get("productSku"), "Unexpected sku " + response.body.sku);
    });
%}

### Get a product by an unknown id (404)
GET {{host}}/api/products/999999
Accept: application/json

> {%
    client.test("404 Product not found", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

### Update product details; sku, stock and id in the body are ignored (200 with a new rowVersion)
PUT {{host}}/api/products/{{productId}}
Content-Type: application/json
Accept: application/json

{
  "sku": "SHOULD-BE-IGNORED",
  "id": 1,
  "name": "Mechanical Keyboard V2",
  "description": "Tactile mechanical keyboard, updated",
  "price": 54.99,
  "stock": 999,
  "rowVersion": "{{originalRowVersion}}"
}

> {%
    client.test("200, new rowVersion, sku and stock unchanged", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.rowVersion !== client.global.get("originalRowVersion"), "Expected a new rowVersion");
        client.assert(response.body.sku === client.global.get("productSku"), "SKU must not change");
        client.assert(response.body.stock === 12, "Stock must not change");
    });
%}

### Update again with the now-stale rowVersion (409)
PUT {{host}}/api/products/{{productId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Mechanical Keyboard V3",
  "price": 59.99,
  "rowVersion": "{{originalRowVersion}}"
}

> {%
    client.test("409 Concurrency conflict", function () {
        client.assert(response.status === 409, "Expected 409 but got " + response.status);
        client.assert(response.body.title === "Concurrency conflict", "Unexpected title: " + response.body.title);
    });
%}

### Update without a rowVersion (400)
PUT {{host}}/api/products/{{productId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Mechanical Keyboard V4",
  "price": 59.99
}

> {%
    client.test("400 with a rowVersion error", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.errors.rowVersion !== undefined, "Expected an error for rowVersion");
    });
%}

