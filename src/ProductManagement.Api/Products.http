### Search products by partial, case-insensitive name (200)
GET {{host}}/api/products/search?name=keyboard
Accept: application/json

> {%
    client.test("200 including the created product", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        var id = client.global.get("productId");
        client.assert(response.body.some(function (p) { return String(p.id) === String(id); }), "Expected product " + id + " in the results");
    });
%}

